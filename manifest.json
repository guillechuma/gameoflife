{
  "schemaVersion": 1,
  "id": "io.github.guillechuma.gameoflife",
  "name": "Game of Life",
  "version": "0.1.0",
  "author": "Guillermo Chumaceiro",
  "license": "MIT",
  "description": "A theme-synced, retro LED-matrix Conway's Game of Life for the Omarchy bar. Lightweight, no dependencies, pure QML + JS.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "Game of Life",
    "category": "Fun",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "cols": 48,
      "rows": 32,
      "speed": 8,
      "wrap": true,
      "trail": 0.35
    },
    "schema": [
      { "key": "cols",  "type": "number",  "label": "Grid columns",       "description": "Cells horizontally.",            "defaultValue": 48 },
      { "key": "rows",  "type": "number",  "label": "Grid rows",          "description": "Cells vertically.",              "defaultValue": 32 },
      { "key": "speed", "type": "number",  "label": "Steps per second",    "description": "Simulation speed while playing.","defaultValue": 8 },
      { "key": "wrap",  "type": "boolean", "label": "Wrap edges",          "description": "Loop edges (torus).",           "defaultValue": true },
      { "key": "trail", "type": "number",  "label": "Trail persistence",   "description": "0 = none, 1 = long CRT fade.",  "defaultValue": 0.35 }
    ]
  }
}
